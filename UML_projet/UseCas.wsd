@startuml SchoolManagementSystem_UseCase

' Detailed compact use-case diagram for A4 landscape.
' No visible packages; inheritance and shared hubs keep the diagram organized.
left to right direction
scale max 3508*2480

skinparam dpi 300
skinparam linetype polyline
skinparam nodesep 4
skinparam ranksep 8
skinparam padding 1
skinparam pageMargin 2
skinparam shadowing false
skinparam roundcorner 3
skinparam backgroundColor #FFFFFF
skinparam ArrowFontSize 6
skinparam ArrowThickness 0.7

skinparam actor {
  BackgroundColor #F8F9FA
  BorderColor #1565C0
  FontSize 8
  FontStyle bold
}

skinparam usecase {
  BorderColor #37474F
  BackgroundColor #FFFFFF
  ArrowColor #455A64
  FontSize 7
}

' ===================== Actors =====================
actor "Portal\nUser" as PortalUser
actor "Staff\nUser" as StaffUser
actor "Learner\nUser" as LearnerUser
actor "Admin" as Admin
actor "Receptionist" as Receptionist
actor "Accountant" as Accountant
actor "Teacher" as Teacher
actor "Student" as Student
actor "Parent" as Parent

' ===================== Shared access =====================
together {
  usecase "Account\naccess" as UC_Access
  usecase "Sign in /\nout" as UC_Auth
  usecase "Switch\nlanguage" as UC_Lang
  usecase "Communication\ncenter" as UC_Communication
  usecase "Send/read\nmessages" as UC_Messages
  usecase "Read\nnotifications" as UC_ReadNotifications
  usecase "Mark notifications\nread" as UC_MarkNotifications
}

' ===================== Main hubs =====================
together {
  usecase "People\nadmin" as UC_PeopleAdmin
  usecase "Student\nreception" as UC_StudentReception
  usecase "Academic\nadmin" as UC_AcademicAdmin
  usecase "Academic\nactivities" as UC_AcademicActivities
  usecase "Teaching\noperations" as UC_TeachingOps
  usecase "Finance\nadmin" as UC_FinanceAdmin
  usecase "Payment\noperations" as UC_PaymentOps
  usecase "Accounting\noperations" as UC_AccountingOps
  usecase "Learner\nmonitoring" as UC_LearnerMonitoring
  usecase "Student\nself-service" as UC_StudentSelfService
  usecase "Parent\nfollow-up" as UC_ParentFollowup
  usecase "Posts\nboard" as UC_PostsBoard
}

' ===================== People details =====================
together {
  usecase "Manage\nusers" as UC_ManageUsers
  usecase "Manage\nparents" as UC_ManageParents
  usecase "Manage\nstudents" as UC_ManageStudents
  usecase "Manage\nteachers" as UC_ManageTeachers
  usecase "Search users /\nstudents" as UC_SearchPeople
  usecase "View\nstudent file" as UC_StudentFile
}

' ===================== Academic details =====================
together {
  usecase "Academic\ndashboard" as UC_AcademicDashboard
  usecase "Manage\nclasses" as UC_ManageClasses
  usecase "Manage\nprograms" as UC_ManagePrograms
  usecase "Manage\nenrollments" as UC_ManageEnrollments
  usecase "Teacher\nassignments" as UC_TeacherAssignments
  usecase "Schedules" as UC_Schedules
  usecase "Attendance" as UC_Attendance
  usecase "Assessments" as UC_Assessments
  usecase "Grades" as UC_Grades
  usecase "Resources" as UC_Resources
}

' ===================== Finance details =====================
together {
  usecase "Finance\ndashboard" as UC_FinanceDashboard
  usecase "Manage/view\nfees" as UC_Fees
  usecase "Record/view\npayments" as UC_Payments
  usecase "View\ntransactions" as UC_Transactions
  usecase "Send fee\nreminder" as UC_FeeReminder
}

' ===================== Learner/community details =====================
together {
  usecase "View\nschedule" as UC_ViewSchedule
  usecase "View\nassessments" as UC_ViewAssessments
  usecase "View\ngrades" as UC_ViewGrades
  usecase "View\nattendance" as UC_ViewAttendance
  usecase "View\nresources" as UC_ViewResources
  usecase "View\nfees" as UC_ViewFees
  usecase "View\nchildren" as UC_ViewChildren
  usecase "Read\nposts" as UC_ReadPosts
  usecase "Manage\nposts" as UC_ManagePosts
  usecase "Preview\nposts" as UC_PreviewPosts
}

' ===================== Actor inheritance =====================
StaffUser --|> PortalUser
LearnerUser --|> PortalUser
Admin --|> StaffUser
Receptionist --|> StaffUser
Accountant --|> StaffUser
Teacher --|> StaffUser
Student --|> LearnerUser
Parent --|> LearnerUser

' ===================== Actor access =====================
PortalUser --> UC_Access
PortalUser --> UC_Communication
LearnerUser --> UC_LearnerMonitoring
Admin --> UC_PeopleAdmin
Admin --> UC_AcademicAdmin
Admin --> UC_FinanceAdmin
Admin --> UC_PostsBoard
Receptionist --> UC_StudentReception
Receptionist --> UC_PaymentOps
Receptionist --> UC_PostsBoard
Accountant --> UC_AccountingOps
Teacher --> UC_TeachingOps
Teacher --> UC_ReadPosts
Student --> UC_StudentSelfService
Parent --> UC_ParentFollowup

' ===================== Shared details =====================
UC_Access ..> UC_Auth : <<include>>
UC_Lang ..> UC_Access : <<extend>>
UC_Communication ..> UC_Messages : <<include>>
UC_Communication ..> UC_ReadNotifications : <<include>>
UC_MarkNotifications ..> UC_ReadNotifications : <<extend>>

' ===================== People details =====================
UC_PeopleAdmin ..> UC_ManageUsers : <<include>>
UC_PeopleAdmin ..> UC_ManageParents : <<include>>
UC_PeopleAdmin ..> UC_ManageStudents : <<include>>
UC_PeopleAdmin ..> UC_ManageTeachers : <<include>>
UC_StudentReception ..> UC_ManageStudents : <<include>>
UC_StudentReception ..> UC_ManageParents : <<include>>
UC_SearchPeople ..> UC_StudentReception : <<extend>>
UC_StudentFile ..> UC_StudentReception : <<extend>>

' ===================== Academic details =====================
UC_AcademicAdmin ..> UC_AcademicDashboard : <<include>>
UC_AcademicAdmin ..> UC_ManageClasses : <<include>>
UC_AcademicAdmin ..> UC_ManagePrograms : <<include>>
UC_AcademicAdmin ..> UC_ManageEnrollments : <<include>>
UC_AcademicAdmin ..> UC_AcademicActivities : <<include>>
UC_TeachingOps ..> UC_AcademicActivities : <<include>>
UC_AcademicActivities ..> UC_TeacherAssignments : <<include>>
UC_AcademicActivities ..> UC_Schedules : <<include>>
UC_AcademicActivities ..> UC_Attendance : <<include>>
UC_AcademicActivities ..> UC_Assessments : <<include>>
UC_AcademicActivities ..> UC_Grades : <<include>>
UC_AcademicActivities ..> UC_Resources : <<include>>

' ===================== Finance details =====================
UC_FinanceAdmin ..> UC_FinanceDashboard : <<include>>
UC_FinanceAdmin ..> UC_PaymentOps : <<include>>
UC_FinanceAdmin ..> UC_Transactions : <<include>>
UC_PaymentOps ..> UC_Fees : <<include>>
UC_PaymentOps ..> UC_Payments : <<include>>
UC_FeeReminder ..> UC_Fees : <<extend>>
UC_AccountingOps ..> UC_PaymentOps : <<include>>
UC_AccountingOps ..> UC_Transactions : <<include>>
UC_AccountingOps ..> UC_Attendance : <<include>>
UC_SearchPeople ..> UC_AccountingOps : <<extend>>

' ===================== Learner/community details =====================
UC_LearnerMonitoring ..> UC_ViewGrades : <<include>>
UC_LearnerMonitoring ..> UC_ViewAttendance : <<include>>
UC_LearnerMonitoring ..> UC_ViewFees : <<include>>
UC_LearnerMonitoring ..> UC_ReadPosts : <<include>>
UC_StudentSelfService ..> UC_ViewSchedule : <<include>>
UC_StudentSelfService ..> UC_ViewAssessments : <<include>>
UC_StudentSelfService ..> UC_ViewResources : <<include>>
UC_ParentFollowup ..> UC_ViewChildren : <<include>>
UC_ParentFollowup ..> UC_LearnerMonitoring : <<include>>
UC_PostsBoard ..> UC_ReadPosts : <<include>>
UC_PostsBoard ..> UC_ManagePosts : <<include>>
UC_PreviewPosts ..> UC_ReadPosts : <<extend>>

' ===================== Workflow dependencies =====================
UC_StudentFile ..> UC_ViewGrades : <<include>>
UC_StudentFile ..> UC_ViewAttendance : <<include>>
UC_Payments ..> UC_Fees : <<include>>
UC_Assessments ..> UC_TeacherAssignments : <<include>>
UC_Grades ..> UC_Assessments : <<include>>
UC_Resources ..> UC_TeacherAssignments : <<include>>
UC_Schedules ..> UC_TeacherAssignments : <<include>>

@enduml
