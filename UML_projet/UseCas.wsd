@startuml SchoolManagementSystem_UseCase

' ===================== إعدادات هندسة الخطوط والتخطيط =====================
left to right direction
skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 80
skinparam padding 5
skinparam roundcorner 10
skinparam shadowing false

skinparam usecase {
    BorderColor #37474F
    BackgroundColor #FFFFFF
    ArrowColor #455A64
    FontSize 11
}

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #1565C0
    FontSize 12
    FontWeight bold
}

skinparam package {
    BorderColor #90A4AE
    FontSize 12
    FontWeight bold
}

' ===================== الفاعلون (Actors) =====================
actor "Administrator" as Admin #FFEBEE
actor "Teacher" as Teacher
actor "Parent" as Parent
actor "Student" as Student
actor "Accountant" as Accountant
actor "POS Cashier" as Cashier
actor "Inventory Mgr" as InvManager

' ===================== وراثة الصلاحيات (Actor Inheritance) =====================
' الأدمن يرث كل صلاحيات وحالات استخدام جميع الممثلين الآخرين
Admin -|> Teacher
Admin -|> Parent
Admin -|> Student
Admin -|> Accountant
Admin -|> Cashier
Admin -|> InvManager

' ===================== 1. محرك الصلاحيات والنظام =====================
package "⚙️ 1. System & Dynamic RBAC" #FFEBEE {
    usecase "Create Infinite Roles" as UC_Roles
    usecase "Configure Access Matrix" as UC_Matrix
    usecase "Global Permission Verification" as UC_Verify
    usecase "View System Logs" as UC_Logs

    UC_Roles .down.> UC_Matrix : <<includes>>
    UC_Verify .up.> UC_Matrix : <<evaluates>>
}

' ===================== 2. الإعدادات والموارد البشرية =====================
package "🛠️ 2. Core Config & HR" #CFD8DC {
    usecase "Manage Branches & Years" as UC_Config
    usecase "Manage All Users (Staff, Students, Parents)" as UC_HR
    usecase "Manage Financial Policies" as UC_Policies
}

' ===================== 3. الأكاديميات والعمليات =====================
package "📚 3. Academics & Operations" #FFECB3 {
    usecase "Manage Programs & Classes" as UC_Prog
    usecase "Manage Enrollments" as UC_Enroll
    usecase "Manage Schedules & Assignments" as UC_Sched
    usecase "Record Attendance" as UC_Attend
    usecase "Input Grades & Assessments" as UC_Grades
    usecase "Manage Educational Resources" as UC_Res
}

' ===================== 4. المالية =====================
package "💰 4. Finance & Accounting" #C8E6C9 {
    usecase "Manage Student Fees & Payments" as UC_Fees
    usecase "Manage Payrolls & Expenses" as UC_FinOps
    usecase "Manage External Obligations" as UC_Oblig
    usecase "Process Daily Cash Handovers" as UC_CashHand
    usecase "Manage User Wallets" as UC_Wallet
}

' ===================== 5. المخزون والمتجر (POS) =====================
package "📦 5. Inventory & Store" #E0F7FA {
    usecase "Process POS Purchase" as UC_POS
    usecase "Manage Inventory Items & Logs" as UC_Inv
    usecase "Record Daily Consumptions" as UC_Consump
}

' ===================== 6. المراسلات والإشعارات =====================
package "💬 6. Communications" #FCE4EC {
    usecase "Send/Receive Messages" as UC_Msg
    usecase "Send Broadcast Notifications" as UC_Notif
}

' ===================== ربط الفاعلين (Connections) =====================

' --- Admin Only Actions (المهام الحصرية للأدمن بالإضافة لما ورثه) ---
Admin --> UC_Roles
Admin --> UC_Config
Admin --> UC_HR
Admin --> UC_Policies
Admin --> UC_Logs
Admin --> UC_Notif

note right of Admin
  **Super User / Unlimited Access:**
  Admin inherits all use cases from all other actors
  and has exclusive access to system config & RBAC.
end note

' --- HR & Academic Users ---
Teacher --> UC_Sched
Teacher --> UC_Attend
Teacher --> UC_Grades
Teacher --> UC_Res
Teacher --> UC_Msg

' --- Clients (Students & Parents) ---
Student --> UC_Res : "Download"
Student --> UC_Grades : "View"
Student --> UC_Msg : "Chat"
Student --> UC_Wallet : "View Balance"

Parent --> UC_Fees : "View & Pay"
Parent --> UC_Grades : "Monitor Children"
Parent --> UC_Attend : "Monitor Children"
Parent --> UC_Msg : "Chat with Teachers/Admin"
Parent --> UC_Wallet : "View Balance / Top-up"

' --- Financial Users ---
Accountant --> UC_Fees
Accountant --> UC_FinOps
Accountant --> UC_Oblig
Accountant --> UC_CashHand
Accountant --> UC_Wallet : "Manage All Wallets"

' --- Store & Inventory Users ---
Cashier --> UC_POS
Cashier --> UC_Wallet : "Process Top-ups"

InvManager --> UC_Inv
InvManager --> UC_Consump
InvManager --> UC_POS : "Stock In/Out"

' --- Universal Engine Rule ---
note "ALL interactions across ALL modules\nare intercepted and validated by\nthe 'Global Permission Verification' engine." as N_Universal
N_Universal .. UC_Verify

@enduml