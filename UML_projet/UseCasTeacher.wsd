@startuml UseCase_Teacher

' Teacher diagram.
left to right direction
scale max 3508*2480

skinparam dpi 300
skinparam linetype ortho
skinparam nodesep 18
skinparam ranksep 24
skinparam padding 2
skinparam pageMargin 2
skinparam shadowing false
skinparam roundcorner 3
skinparam backgroundColor #FFFFFF
skinparam ArrowFontSize 7
skinparam ArrowThickness 0.75

skinparam actor {
  BackgroundColor #F8F9FA
  BorderColor #1565C0
  FontSize 9
  FontStyle bold
}

skinparam usecase {
  BorderColor #37474F
  BackgroundColor #FFFFFF
  ArrowColor #455A64
  FontSize 8
}

actor "Teacher" as Teacher

together {
  usecase "Account\naccess" as UC_Access
  usecase "Sign in /\nout" as UC_Auth
  usecase "Switch\nlanguage" as UC_Lang
  usecase "Communication\ncenter" as UC_Communication
  usecase "Send/read\nmessages" as UC_Messages
  usecase "Read\nnotifications" as UC_ReadNotifications
  usecase "Mark notifications\nread" as UC_MarkNotifications
}

together {
  usecase "Teaching\noperations" as UC_TeachingOps
  usecase "Academic\nactivities" as UC_AcademicActivities
  usecase "Teacher\nassignments" as UC_TeacherAssignments
}

together {
  usecase "Schedules" as UC_Schedules
  usecase "Attendance" as UC_Attendance
  usecase "Assessments" as UC_Assessments
  usecase "Grades" as UC_Grades
  usecase "Resources" as UC_Resources
}

together {
  usecase "Posts\nboard" as UC_PostsBoard
  usecase "Read\nposts" as UC_ReadPosts
}

Teacher --> UC_Access
Teacher --> UC_Communication
Teacher --> UC_TeachingOps
Teacher --> UC_PostsBoard

UC_Access .right.> UC_Auth : <<include>>
UC_Lang .left.> UC_Access : <<extend>>
UC_Communication .right.> UC_Messages : <<include>>
UC_Communication .right.> UC_ReadNotifications : <<include>>
UC_MarkNotifications .left.> UC_ReadNotifications : <<extend>>

UC_TeachingOps .right.> UC_AcademicActivities : <<include>>
UC_AcademicActivities .up.> UC_TeacherAssignments : <<include>>
UC_AcademicActivities .up.> UC_Schedules : <<include>>
UC_AcademicActivities .right.> UC_Attendance : <<include>>
UC_AcademicActivities .right.> UC_Assessments : <<include>>
UC_AcademicActivities .down.> UC_Grades : <<include>>
UC_AcademicActivities .down.> UC_Resources : <<include>>

UC_Assessments .up.> UC_TeacherAssignments : <<include>>
UC_Grades .right.> UC_Assessments : <<include>>
UC_Resources .down.> UC_TeacherAssignments : <<include>>
UC_Schedules .up.> UC_TeacherAssignments : <<include>>

UC_PostsBoard .right.> UC_ReadPosts : <<include>>

@enduml
