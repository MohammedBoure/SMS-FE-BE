@startuml SchoolManagementSystem_A3


left to right direction
scale max 4960*3508

skinparam dpi 300
skinparam linetype ortho

' تقليل المسافات لإجبار العناصر على التقارب المدروس
skinparam nodesep 8
skinparam ranksep 18
skinparam padding 1
skinparam pageMargin 4

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 3
skinparam backgroundColor #FFFFFF

skinparam class {
  BorderColor #2C3E50
  ArrowColor #34495E
  BackgroundColor #FDFEFE
  FontSize 9
  AttributeFontSize 8
}


class RolesTable <<table>> {
  - id: INT
  - name: VARCHAR(50) UNIQUE NOT NULL
}

class UsersManager {
  - id: INT
  - role_id: INT NULL
  - username: VARCHAR(50) UNIQUE NOT NULL
  - password: VARCHAR(255) NOT NULL
  - email: VARCHAR(100) UNIQUE
  - full_name: VARCHAR(100) NOT NULL
  - phone: VARCHAR(20)
  - address: TEXT
  - is_active: BOOLEAN
  - created_at: TIMESTAMP
  ..
  + create_user(role_id: Integer, username: String,\n  password: String, full_name: String,\n  email: String, phone: String, address: String,\n  is_active: Boolean): Integer
  + authenticate_user(username: String,\n  password: String): Dictionary
  + get_all_users(role_name: String, is_active: Boolean,\n  limit: Integer, offset: Integer): Dictionary
  + get_user_by_id(user_id: Integer): Dictionary
  + search_users(keyword: String, limit: Integer,\n  offset: Integer): Dictionary
  + update_user(user_id: Integer, **kwargs): Boolean
  + change_user_status(user_id: Integer,\n  is_active: Boolean): Boolean
  + delete_user(user_id: Integer): Tuple
}

class ParentsManager {
  - id: INT
  - user_id: INT UNIQUE
  ..
  + create_parent(user_id: Integer): Integer
  + get_all_parents(): List
  + get_parent_by_id(parent_id: Integer): Dictionary
  + get_parent_by_user_id(user_id: Integer): Dictionary
  + get_parent_students(parent_id: Integer): List
  + delete_parent(parent_id: Integer): Tuple
}

class TeachersManager {
  - id: INT
  - user_id: INT UNIQUE
  - specialty: VARCHAR(100)
  - hire_date: DATE
  ..
  + create_teacher(user_id: Integer, specialty: String,\n  hire_date: String): Integer
  + search_teachers(keyword: String): List
  + get_all_teachers(): List
  + get_teacher_by_id(teacher_id: Integer): Dictionary
  + get_teacher_assignments(teacher_id: Integer): List
  + update_teacher(teacher_id: Integer, **kwargs): Boolean
  + delete_teacher(teacher_id: Integer): Tuple
}

class SubjectsManager {
  - id: INT
  - subject_name: VARCHAR(100)
  - description: TEXT
  ..
  + add_subject(subject_name: String,\n  description: String): Integer
  + get_all_subjects(): List
  + get_subject_by_id(subject_id: Integer): Dictionary
  + search_subjects(keyword: String): List
  + get_subjects_with_teacher_count(): List
  + update_subject(subject_id: Integer, subject_name: String,\n  description: String): Boolean
  + delete_subject(subject_id: Integer): Tuple
}


class ClassesManager {
  - id: INT
  - program_id: INT NULL
  - class_name: VARCHAR(50) NOT NULL
  - level: VARCHAR(50)
  - age_group: VARCHAR(50) NULL
  - capacity: INT
  ..
  + add_class(class_name: String, level: String,\n  age_group: String, capacity: Integer, program_id: Integer): Integer
  + get_all_classes(level: String, program_id: Integer): List
  + get_class_by_id(class_id: Integer): Dictionary
  + get_classes_occupancy(): List
  + update_class(class_id: Integer, **kwargs): Boolean
  + delete_class(class_id: Integer): Tuple
}

class ProgramsManager {
  - id: INT
  - program_name: VARCHAR(100) NOT NULL
  - program_type: VARCHAR(50) NOT NULL
  - price_cash: INT
  - price_installments: INT
  ..
  + create_program(program_name: String, program_type: String,\n  price_cash: Integer, price_installments: Integer): Integer
  + get_all_programs(program_type: String): List
  + get_program_by_id(program_id: Integer): Dictionary
  + search_programs(keyword: String): List
  + get_programs_summary(): List
  + update_program(program_id: Integer, **kwargs): Boolean
  + delete_program(program_id: Integer): Tuple
}

class StudentEnrollmentsManager {
  - id: INT
  - student_id: INT
  - program_id: INT
  - class_id: INT NULL
  - group_name: VARCHAR(50)
  - enrollment_date: DATE
  - status: VARCHAR(50)
  - notes: TEXT
  ..
  - _class_matches_program(cursor: Cursor, class_id: Integer, program_id: Integer): Boolean
  + create_enrollment(student_id: Integer, program_id: Integer,\n  class_id: Integer, group_name: String, enrollment_date: String,\n  status: String, notes: String): Integer
  + get_all_enrollments(status: String, program_id: Integer, class_id: Integer): List
  + get_student_enrollments(student_id: Integer): List
  + get_program_enrollments(program_id: Integer, status: String, class_id: Integer): List
  + get_class_enrollments(class_id: Integer, status: String): List
  + update_enrollment(enrollment_id: Integer, **kwargs): Boolean
  + change_enrollment_status(enrollment_id: Integer,\n  status: String): Boolean
  + delete_enrollment(enrollment_id: Integer): Tuple
}

class TeacherAssignmentsManager {
  - id: INT
  - teacher_id: INT
  - subject_id: INT
  - class_id: INT
  ..
  + assign_teacher(teacher_id: Integer, subject_id: Integer,\n  class_id: Integer): Integer
  + get_all_assignments(): List
  + get_assignments_by_class(class_id: Integer): List
  + get_assignments_by_teacher(teacher_id: Integer): List
  + update_assignment(assignment_id: Integer, **kwargs): Boolean
  + delete_assignment(assignment_id: Integer): Tuple
}

class AssessmentsManager {
  - id: INT 
  - title: VARCHAR(100) 
  - type: VARCHAR(50) 
  - max_grade: DOUBLE 
  - assignment_id: INT
  - due_date: DATE 
  ..
  + create_assessment(title: String, type: String,\n  assignment_id: Integer, max_grade: Float,\n  due_date: String): Integer 
  + get_all_assessments(): List 
  + get_assessments_by_class(class_id: Integer): List 
  + get_assessments_by_student(student_id: Integer): List
  + get_assessments_by_assignment(assignment_id: Integer): List 
  + get_assessment_by_id(assessment_id: Integer): Dictionary 
  + update_assessment(assessment_id: Integer, **kwargs): Boolean 
  + delete_assessment(assessment_id: Integer): Tuple 
}

class GradesManager {
  - id: INT
  - student_id: INT
  - assessment_id: INT
  - grade_value: DOUBLE NOT NULL
  - teacher_remarks: TEXT
  ..
  + save_grade(student_id: Integer, assessment_id: Integer,\n  grade_value: Float, teacher_remarks: String): Integer
  + get_assessment_grades(assessment_id: Integer): List
  + get_student_grades(student_id: Integer): List
  + get_assessment_statistics(assessment_id: Integer): Dictionary
  + delete_grade(grade_id: Integer): Tuple
}

class AttendanceManager {
  - id: INT
  - student_id: INT
  - class_id: INT NULL
  - date: DATE NOT NULL
  - status: VARCHAR(20) NOT NULL
  - is_justified: BOOLEAN DEFAULT FALSE
  - justification_reason: TEXT
  ..
  - _student_has_active_class_enrollment(cursor: Cursor, student_id: Integer, class_id: Integer): Boolean
  + save_attendance(student_id: Integer, target_date: String,\n  status: String, class_id: Integer, is_justified: Boolean,\n  justification_reason: String): Integer
  + get_class_attendance_sheet(class_id: Integer,\n  target_date: String): List
  + get_student_attendance(student_id: Integer,\n  start_date: String, end_date: String, class_id: Integer): List
  + get_attendance_statistics(student_id: Integer, class_id: Integer): Dictionary
  + update_justification(attendance_id: Integer,\n  is_justified: Boolean, justification_reason: String): Boolean
  + delete_attendance(attendance_id: Integer): Tuple
}
class SchedulesManager {
  - id: INT
  - assignment_id: INT
  - day_of_week: ENUM(Sunday, Monday, Tuesday, Wednesday, Thursday, Friday, Saturday)
  - start_time: TIME
  - end_time: TIME
  - room_number: VARCHAR(20)
  ..
  - _check_conflict(cursor: Cursor, assignment_id: Integer,\n  day_of_week: String, start_time: String,\n  end_time: String, room_number: String,\n  exclude_schedule_id: Integer): String
  + get_student_schedule(student_id: Integer): List
  + add_schedule(assignment_id: Integer, day_of_week: String,\n  start_time: String, end_time: String,\n  room_number: String): Integer
  + get_class_schedule(class_id: Integer): List
  + get_teacher_schedule(teacher_id: Integer): List
  + update_schedule(schedule_id: Integer, **kwargs): Boolean
  + delete_schedule(schedule_id: Integer): Tuple
}

class ResourcesManager {
  - id: INT
  - title: VARCHAR(255)
  - description: TEXT
  - resource_type: VARCHAR(50)
  - file_path_or_url: VARCHAR(500)
  - file_size_mb: DOUBLE
  - assignment_id: INT
  - upload_date: TIMESTAMP
  ..
  + create_resource(title: String, resource_type: String,\n  file_path_or_url: String, description: String,\n  file_size_mb: Float, assignment_id: Integer): Integer
  + search_resources(keyword: String, resource_type: String): List
  + get_resources_by_assignment(assignment_id: Integer): List
  + get_all_resources(): List
  + get_resource_by_id(resource_id: Integer): Dictionary
  + update_resource(resource_id: Integer, **kwargs): Boolean
  + delete_resource(resource_id: Integer): Tuple
}

class UserTransactionsManager {
  - id: INT
  - from_user_id: INT NOT NULL
  - to_user_id: INT NOT NULL
  - amount: INT NOT NULL
  - transaction_type: VARCHAR(50) NOT NULL
  - reference_type: VARCHAR(50)
  - reference_id: INT
  - notes: TEXT
  - status: ENUM(pending, completed, cancelled)
  - created_at: TIMESTAMP
  ..
  + create_transaction(from_user_id: Integer, to_user_id: Integer,\n  amount: Integer, transaction_type: String,\n  reference_type: String, reference_id: Integer,\n  notes: String, status: String): Integer
  + get_all_transactions(status: String,\n  transaction_type: String): List
  + get_transaction_by_id(transaction_id: Integer): Dictionary
  + get_user_statement(user_id: Integer): List
  + update_transaction_status(transaction_id: Integer,\n  status: String, notes: String): Boolean
  + delete_transaction(transaction_id: Integer): Tuple
}

class PaymentsManager {
  - id: INT
  - fee_id: INT
  - transaction_id: INT UNIQUE
  - amount_paid: INT NOT NULL
  - installment_number: INT
  - payment_date: TIMESTAMP
  - receipt_number: VARCHAR(50) UNIQUE
  ..
  + record_payment(fee_id: Integer, amount_paid: Integer,\n  installment_number: Integer, transaction_id: Integer,\n  receipt_number: String): Integer
  + get_all_payments(): List
  + get_payments_by_fee(fee_id: Integer): List
  + get_student_payments(student_id: Integer): List
  + get_fee_balance(fee_id: Integer): Dictionary
  + update_payment(payment_id: Integer, **kwargs): Boolean
  + delete_payment(payment_id: Integer): Tuple
}

class ConversationsManager {
  - id: INT
  - title: VARCHAR(255)
  - type: VARCHAR(20)
  - created_at: TIMESTAMP
  ..
  + create_conversation(title: String, conv_type: String): Integer
  + get_all_conversations(conv_type: String, limit: Integer): List
  + get_conversation_by_id(conv_id: Integer): Dictionary
  + search_conversations(keyword: String, conv_type: String): List
  + get_recent_conversations(days: Integer, limit: Integer): List
  + get_conversations_summary(): Dictionary
  + update_conversation(conv_id: Integer, title: String,\n  conv_type: String): Boolean
  + delete_conversation(conv_id: Integer): Tuple
  + delete_old_conversations(days_old: Integer): Tuple
}

class MessagesManager {
  - id: INT
  - content: TEXT NOT NULL
  - created_at: TIMESTAMP
  - sender_id: INT NOT NULL
  - receiver_id: INT NOT NULL
  ..
  + send_message(sender_id: Integer, receiver_id: Integer,\n  content: String): Integer
  + get_message_by_id(message_id: Integer): Dictionary
  + get_conversation(user1_id: Integer, user2_id: Integer): List
  + get_user_inbox(user_id: Integer): List
}

class PostsManager {
  - id: INT
  - title: VARCHAR(255) NOT NULL
  - content: TEXT NOT NULL
  - image: VARCHAR(500)
  - created_at: TIMESTAMP
  - user_id: INT NOT NULL
  ..
  + create_post(title: String, content: String,\n  user_id: Integer, image: String): Integer
  + get_all_posts(): List
  + get_post_by_id(post_id: Integer): Dictionary
  + get_posts_by_user(user_id: Integer): List
  + update_post(post_id: Integer, **kwargs): Boolean
  + delete_post(post_id: Integer): Tuple
}

class StudentsManager {
  - id: INT
  - user_id: INT UNIQUE
  - parent_id: INT NULL
  - class_id: INT NULL
  - date_of_birth: DATE
  - registration_date: DATE
  - blood_group: VARCHAR(5)
  - medical_info: TEXT
  - status: VARCHAR(20)
  ..
  - _enrollment_summary_join(): String
  - _class_filter_sql(class_id: Integer, params: List): String
  + create_student(user_id: Integer, parent_id: Integer, class_id: Integer,\n  date_of_birth: String, registration_date: String, blood_group: String,\n  medical_info: String, status: String): Integer
  + search_students(keyword: String, limit: Integer, offset: Integer): Dictionary
  + get_all_students(status: String, class_id: Integer,\n  limit: Integer, offset: Integer): Dictionary
  + get_student_by_id(student_id: Integer): Dictionary
  + update_student(student_id: Integer, **kwargs): Boolean
  + change_student_status(student_id: Integer, status: String): Boolean
  + delete_student(student_id: Integer, force: Boolean): Tuple
}

class StudentFeesManager {
  - id: INT
  - student_id: INT
  - enrollment_id: INT NULL
  - program_id: INT NULL
  - fee_type: VARCHAR(50) NOT NULL
  - amount_due: INT NOT NULL
  - applied_discount: INT
  - due_date: DATE
  - transaction_id: INT NULL
  ..
  - _resolve_program_for_enrollment(cursor: Cursor, student_id: Integer,\n  enrollment_id: Integer, program_id: Integer): Tuple
  + create_fee(student_id: Integer, fee_type: String, amount_due: Integer,\n  enrollment_id: Integer, program_id: Integer, applied_discount: Integer,\n  due_date: String, transaction_id: Integer): Integer
  + get_all_fees(fee_type: String): List
  + get_student_fees(student_id: Integer): List
  + get_overdue_fees(): List
  + update_fee(fee_id: Integer, **kwargs): Boolean
  + delete_fee(fee_id: Integer): Tuple
}

class NotificationsManager {
  - id: INT
  - user_id: INT
  - title: VARCHAR(255)
  - message: TEXT
  - is_read: BOOLEAN
  - created_at: TIMESTAMP
  ..
  + create_notification(user_id: Integer, title: String,\n  message: String): Integer
  + create_bulk_notifications(user_ids: List, title: String,\n  message: String): Boolean
  + get_all_notifications(limit: Integer): List
  + get_user_notifications(user_id: Integer,\n  unread_only: Boolean, limit: Integer): List
  + get_unread_count(user_id: Integer): Integer
  + mark_as_read(notification_id: Integer): Boolean
  + mark_all_as_read(user_id: Integer): Boolean
  + delete_notification(notification_id: Integer): Tuple
  + delete_old_notifications(days_old: Integer): Tuple
}

legend right
  *-- composition: child rows are deleted with the owner
  o-- aggregation: optional/shared reference, often SET NULL
  --> association: reference without clear whole/part ownership
endlegend

RolesTable "0..1" o-- "*" UsersManager : role_id
UsersManager "1" *-- "0..1" ParentsManager : user_id UNIQUE
UsersManager "1" *-- "0..1" StudentsManager : user_id UNIQUE
UsersManager "1" *-- "0..1" TeachersManager : user_id UNIQUE

ParentsManager "0..1" o-- "*" StudentsManager : parent_id
ClassesManager "0..1" o-- "*" StudentsManager : class_id
ProgramsManager "0..1" o-- "*" ClassesManager : program_id

StudentsManager "1" *-- "*" StudentEnrollmentsManager : student_id
ProgramsManager "1" *-- "*" StudentEnrollmentsManager : program_id
ClassesManager "0..1" o-- "*" StudentEnrollmentsManager : class_id

TeachersManager "1" *-- "*" TeacherAssignmentsManager : teacher_id
SubjectsManager "1" *-- "*" TeacherAssignmentsManager : subject_id
ClassesManager "1" *-- "*" TeacherAssignmentsManager : class_id

TeacherAssignmentsManager "0..1" o-- "*" ResourcesManager : assignment_id
TeacherAssignmentsManager "1" *-- "*" AssessmentsManager : assignment_id
TeacherAssignmentsManager "1" *-- "*" SchedulesManager : assignment_id

StudentsManager "1" *-- "*" GradesManager : student_id
AssessmentsManager "1" *-- "*" GradesManager : assessment_id

ClassesManager "0..1" o-- "*" AttendanceManager : class_id
StudentsManager "1" *-- "*" AttendanceManager : student_id
AttendanceManager ..> StudentEnrollmentsManager : active enrollment check

UsersManager "1" --> "*" UserTransactionsManager : from_user_id
UsersManager "1" --> "*" UserTransactionsManager : to_user_id

StudentsManager "1" *-- "*" StudentFeesManager : student_id
ProgramsManager "0..1" o-- "*" StudentFeesManager : program_id
UserTransactionsManager "0..1" o-- "*" StudentFeesManager : transaction_id
StudentEnrollmentsManager "0..1" o-- "*" StudentFeesManager : enrollment_id

StudentFeesManager "1" *-- "*" PaymentsManager : fee_id
UserTransactionsManager "0..1" o-- "0..1" PaymentsManager : transaction_id UNIQUE

UsersManager "1" *-- "*" NotificationsManager : user_id
UsersManager "1" *-- "*" PostsManager : user_id
UsersManager "1" --> "*" MessagesManager : sender_id
UsersManager "1" --> "*" MessagesManager : receiver_id

@enduml
