@startuml UseCase_Parent

' Parent diagram.
left to right direction
scale max 3508*2480

skinparam dpi 300
skinparam linetype ortho
skinparam nodesep 18
skinparam ranksep 24
skinparam padding 2
skinparam pageMargin 2
skinparam shadowing false
skinparam roundcorner 3
skinparam backgroundColor #FFFFFF
skinparam ArrowFontSize 7
skinparam ArrowThickness 0.75

skinparam actor {
  BackgroundColor #F8F9FA
  BorderColor #1565C0
  FontSize 9
  FontStyle bold
}

skinparam usecase {
  BorderColor #37474F
  BackgroundColor #FFFFFF
  ArrowColor #455A64
  FontSize 8
}

actor "Parent" as Parent

together {
  usecase "Account\naccess" as UC_Access
  usecase "Sign in /\nout" as UC_Auth
  usecase "Switch\nlanguage" as UC_Lang
  usecase "Communication\ncenter" as UC_Communication
  usecase "Send/read\nmessages" as UC_Messages
  usecase "Read\nnotifications" as UC_ReadNotifications
  usecase "Mark notifications\nread" as UC_MarkNotifications
}

together {
  usecase "Parent\nfollow-up" as UC_ParentFollowup
  usecase "View\nchildren" as UC_ViewChildren
  usecase "Learner\nmonitoring" as UC_LearnerMonitoring
}

together {
  usecase "View\ngrades" as UC_ViewGrades
  usecase "View\nattendance" as UC_ViewAttendance
  usecase "View\nfees" as UC_ViewFees
  usecase "Read\nposts" as UC_ReadPosts
}

Parent --> UC_Access
Parent --> UC_Communication
Parent --> UC_ParentFollowup

UC_Access .right.> UC_Auth : <<include>>
UC_Lang .left.> UC_Access : <<extend>>
UC_Communication .right.> UC_Messages : <<include>>
UC_Communication .right.> UC_ReadNotifications : <<include>>
UC_MarkNotifications .left.> UC_ReadNotifications : <<extend>>

UC_ParentFollowup .right.> UC_ViewChildren : <<include>>
UC_ParentFollowup .right.> UC_LearnerMonitoring : <<include>>

UC_LearnerMonitoring .up.> UC_ViewGrades : <<include>>
UC_LearnerMonitoring .right.> UC_ViewAttendance : <<include>>
UC_LearnerMonitoring .down.> UC_ViewFees : <<include>>
UC_LearnerMonitoring .right.> UC_ReadPosts : <<include>>

@enduml
